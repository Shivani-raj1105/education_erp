// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Academic Settings - Stores current academic year and semester type
model AcademicSettings {
  id                  Int      @id @default(autoincrement())
  academicYear        String   @map("academic_year") @db.VarChar(20)
  currentSemesterType String   @map("current_semester_type") @db.VarChar(10) // ODD or EVEN
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  @@map("academic_settings")
}

// Semester - Stores all available semesters
model Semester {
  id             Int      @id @default(autoincrement())
  semesterNumber Int      @unique @map("semester_number") // 1, 2, 3, 4, 5, 6, 7, 8
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  sections   Section[]
  subjects   Subject[]
  timetables Timetable[]

  @@map("semesters")
}

// Section - Stores sections for each semester
model Section {
  id          Int      @id @default(autoincrement())
  semesterId  Int      @map("semester_id")
  sectionName String   @map("section_name") @db.VarChar(10) // A, B, C, D
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  semester   Semester    @relation(fields: [semesterId], references: [id], onDelete: Cascade)
  students   Student[]
  timetables Timetable[]

  @@unique([semesterId, sectionName])
  @@index([semesterId])
  @@map("sections")
}

// Faculty - Stores faculty information
model Faculty {
  id        Int      @id @default(autoincrement())
  name      String   @db.VarChar(100)
  email     String   @unique @db.VarChar(100)
  password  String   @db.VarChar(255)
  role      String   @default("FACULTY") @db.VarChar(20) // HOD, FACULTY
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  subjectFaculties SubjectFaculty[]
  timetables       Timetable[]

  @@index([email])
  @@map("faculties")
}

// Subject - Stores subjects for each semester
model Subject {
  id          Int      @id @default(autoincrement())
  subjectName String   @map("subject_name") @db.VarChar(100)
  subjectCode String   @unique @map("subject_code") @db.VarChar(20)
  semesterId  Int      @map("semester_id")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  semester         Semester         @relation(fields: [semesterId], references: [id], onDelete: Cascade)
  subjectFaculties SubjectFaculty[]
  timetables       Timetable[]

  @@index([semesterId])
  @@map("subjects")
}

// SubjectFaculty - Mapping between subjects and faculty
model SubjectFaculty {
  id        Int      @id @default(autoincrement())
  subjectId Int      @map("subject_id")
  facultyId Int      @map("faculty_id")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  subject Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  faculty Faculty @relation(fields: [facultyId], references: [id], onDelete: Cascade)

  @@unique([subjectId, facultyId])
  @@index([subjectId])
  @@index([facultyId])
  @@map("subject_faculties")
}

// Student - Stores student information
model Student {
  id         Int      @id @default(autoincrement())
  usn        String   @unique @db.VarChar(20)
  name       String   @db.VarChar(100)
  phone      String   @db.VarChar(15)
  email      String   @unique @db.VarChar(100)
  semesterId Int      @map("semester_id")
  sectionId  Int      @map("section_id")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  section     Section      @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  attendance  Attendance?
  performance Performance?

  @@index([semesterId])
  @@index([sectionId])
  @@index([usn])
  @@map("students")
}

// Timetable - Stores timetable for each section (uploaded by Faculty Portal)
model Timetable {
  id         Int      @id @default(autoincrement())
  day        String   @db.VarChar(20) // Monday, Tuesday, etc.
  period     Int // 1, 2, 3, 4, 5, etc.
  subjectId  Int      @map("subject_id")
  facultyId  Int      @map("faculty_id")
  semesterId Int      @map("semester_id")
  sectionId  Int      @map("section_id")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  subject  Subject  @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  faculty  Faculty  @relation(fields: [facultyId], references: [id], onDelete: Cascade)
  semester Semester @relation(fields: [semesterId], references: [id], onDelete: Cascade)
  section  Section  @relation(fields: [sectionId], references: [id], onDelete: Cascade)

  @@unique([day, period, semesterId, sectionId])
  @@index([semesterId, sectionId])
  @@map("timetables")
}

// Attendance - Stores attendance percentage (managed by Team-3)
model Attendance {
  id                   Int      @id @default(autoincrement())
  studentId            Int      @unique @map("student_id")
  attendancePercentage Float    @map("attendance_percentage") @db.DoublePrecision
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId])
  @@map("attendances")
}

// Performance - Stores performance percentage (managed by Team-3)
model Performance {
  id                    Int      @id @default(autoincrement())
  studentId             Int      @unique @map("student_id")
  performancePercentage Float    @map("performance_percentage") @db.DoublePrecision
  createdAt             DateTime @default(now()) @map("created_at")
  updatedAt             DateTime @updatedAt @map("updated_at")

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId])
  @@map("performances")
}
