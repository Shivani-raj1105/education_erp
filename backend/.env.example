# Database — update these values to match your local PostgreSQL setup
DATABASE_URL="postgresql://<DB_USER>:<DB_PASSWORD>@localhost:<DB_PORT>/<DB_NAME>"
# Example: DATABASE_URL="postgresql://postgres:yourpassword@localhost:5432/department_erp"

# JWT — use a strong random string (min 32 chars) for each secret
JWT_SECRET="change-this-to-a-long-random-secret-min-32-chars"
JWT_EXPIRES_IN="8h"
JWT_REFRESH_SECRET="change-this-to-another-long-random-secret"
JWT_REFRESH_EXPIRES_IN="7d"

# Server
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:3000

# File Upload
UPLOAD_DIR=uploads
MAX_FILE_SIZE=5242880

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
