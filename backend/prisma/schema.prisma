// Prisma Schema - Simplified Single Table Design
// All faculty data in one table for simplicity

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model FacultyList {
  employeeId       String   @id  // e.g. "EMP001"
  name             String
  email            String   @unique
  phone            String?
  designation      String
  specialization   String?
  qualification    String?
  experience       Int      @default(0)  // years
  joiningDate      DateTime
  photo            String?
  status           String   @default("ACTIVE")  // ACTIVE, INACTIVE, ON_LEAVE
  coordinatorRoles String?  // comma-separated: "TIMETABLE_COORDINATOR,EXAM_COORDINATOR"
  
  // Auth & Department
  username         String   @unique
  passwordHash     String
  departmentCode   String   // e.g. "CSE", "ECE"
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("faculty_list")
}

// ─── Student Activities ───────────────────────────────────────────────────────

model TechnicalEvent {
  id             String   @id @default(uuid())
  studentName    String
  usn            String   // USN / Roll Number
  department     String
  section        String
  semester       Int
  eventType      String   // e.g. "Hackathon", "Project", "Paper Presentation", "Coding Contest"
  projectName    String   // Project / Event Name
  projectDomain  String
  academicYear   String   // e.g. "2024-25"
  facultyMentor  String?  // optional
  projectStatus  String   @default("ONGOING")  // ONGOING, COMPLETED
  departmentCode String   // dept scoping (HOD's dept)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("technical_events")
}

model SportsActivity {
  id               String   @id @default(uuid())
  studentName      String
  usn              String
  department       String
  section          String
  semester         Int
  sportName        String
  competitionLevel String   // e.g. "District", "State", "National", "International"
  positionMedal    String?  // e.g. "Gold", "1st Place"
  academicYear     String
  departmentCode   String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("sports_activities")
}

model CulturalActivity {
  id                  String   @id @default(uuid())
  studentName         String
  usn                 String
  department          String
  section             String
  semester            Int
  culturalActivityName String  // e.g. "Dance", "Singing", "Drama"
  eventName           String   // e.g. "Annual Day 2024"
  positionPrize       String?  // e.g. "1st Prize", "Best Performer"
  academicYear        String
  departmentCode      String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("cultural_activities")
}

// ─── Enhanced Activities ──────────────────────────────────────────────────────

// Real-Time Industry Projects (one project → many students)
model IndustryProject {
  id             String   @id @default(uuid())
  projectName    String
  status         String   @default("ONGOING")  // ONGOING, COMPLETED
  departmentCode String

  students       IndustryProjectStudent[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("industry_projects")
}

model IndustryProjectStudent {
  id          String   @id @default(uuid())
  projectId   String
  studentName String
  usn         String
  semester    Int
  section     String

  project     IndustryProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("industry_project_students")
}

// Hackathons
model Hackathon {
  id             String   @id @default(uuid())
  studentName    String
  usn            String
  semester       Int
  section        String
  hackathonName  String
  position       String   // e.g. "1st Place", "Runner Up", "Participant"
  year           Int
  departmentCode String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("hackathons")
}

// Other Curricular Activities (replaces older CulturalActivity in the new hierarchy)
model OtherCurricularActivity {
  id               String   @id @default(uuid())
  studentName      String
  usn              String
  semester         Int
  section          String
  eventName        String
  organizingCollege String
  achievement      String?
  year             Int
  departmentCode   String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("other_curricular_activities")
}

// ─── Student List Module ──────────────────────────────────────────────────────

// Stores the current academic year and semester type (ODD/EVEN)
model AcademicSettings {
  id                  Int      @id @default(autoincrement())
  academicYear        String   @map("academic_year") @db.VarChar(20)
  currentSemesterType String   @map("current_semester_type") @db.VarChar(10)
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  @@map("academic_settings")
}

// Semester numbers 1–8
model Semester {
  id             Int      @id @default(autoincrement())
  semesterNumber Int      @unique @map("semester_number")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  sections   Section[]
  subjects   Subject[]
  timetables Timetable[]

  @@map("semesters")
}

// Sections per semester (A, B, C, D)
model Section {
  id          Int      @id @default(autoincrement())
  semesterId  Int      @map("semester_id")
  sectionName String   @map("section_name") @db.VarChar(10)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  semester   Semester   @relation(fields: [semesterId], references: [id], onDelete: Cascade)
  students   Student[]
  timetables Timetable[]

  @@unique([semesterId, sectionName])
  @@index([semesterId])
  @@map("sections")
}

// Faculty for the student-list module
model SlFaculty {
  id        Int      @id @default(autoincrement())
  name      String   @db.VarChar(100)
  email     String   @unique @db.VarChar(100)
  password  String   @db.VarChar(255)
  role      String   @default("FACULTY") @db.VarChar(20)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  subjectMappings SubjectFaculty[]
  timetables      Timetable[]

  @@map("sl_faculties")
}

// Subjects per semester
model Subject {
  id          Int      @id @default(autoincrement())
  subjectName String   @map("subject_name") @db.VarChar(100)
  subjectCode String   @unique @map("subject_code") @db.VarChar(20)
  semesterId  Int      @map("semester_id")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  semester        Semester         @relation(fields: [semesterId], references: [id], onDelete: Cascade)
  subjectMappings SubjectFaculty[]
  timetables      Timetable[]

  @@index([semesterId])
  @@map("subjects")
}

// Subject to Faculty mapping
model SubjectFaculty {
  id        Int      @id @default(autoincrement())
  subjectId Int      @map("subject_id")
  facultyId Int      @map("faculty_id")
  createdAt DateTime @default(now()) @map("created_at")

  subject Subject   @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  faculty SlFaculty @relation(fields: [facultyId], references: [id], onDelete: Cascade)

  @@unique([subjectId, facultyId])
  @@index([subjectId])
  @@map("subject_faculties")
}

// Student details
model Student {
  id         Int      @id @default(autoincrement())
  usn        String   @unique @db.VarChar(20)
  name       String   @db.VarChar(100)
  phone      String   @db.VarChar(15)
  email      String   @unique @db.VarChar(100)
  semesterId Int      @map("semester_id")
  sectionId  Int      @map("section_id")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  section     Section      @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  attendance  Attendance?
  performance Performance?

  @@index([semesterId])
  @@index([sectionId])
  @@map("students")
}

// Timetable (uploaded by Faculty Portal team, read-only from this module)
model Timetable {
  id         Int      @id @default(autoincrement())
  day        String   @db.VarChar(20)
  period     Int
  subjectId  Int      @map("subject_id")
  facultyId  Int      @map("faculty_id")
  semesterId Int      @map("semester_id")
  sectionId  Int      @map("section_id")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  subject  Subject   @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  faculty  SlFaculty @relation(fields: [facultyId], references: [id], onDelete: Cascade)
  semester Semester  @relation(fields: [semesterId], references: [id], onDelete: Cascade)
  section  Section   @relation(fields: [sectionId], references: [id], onDelete: Cascade)

  @@unique([day, period, semesterId, sectionId])
  @@index([semesterId, sectionId])
  @@map("timetables")
}

// Attendance managed by Team-3, this module only reads
model Attendance {
  id                   Int      @id @default(autoincrement())
  studentId            Int      @unique @map("student_id")
  attendancePercentage Float    @map("attendance_percentage") @db.DoublePrecision
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@map("attendances")
}

// Performance managed by Team-3, this module only reads
model Performance {
  id                    Int      @id @default(autoincrement())
  studentId             Int      @unique @map("student_id")
  performancePercentage Float    @map("performance_percentage") @db.DoublePrecision
  createdAt             DateTime @default(now()) @map("created_at")
  updatedAt             DateTime @updatedAt @map("updated_at")

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@map("performances")
}
